+static void ovl_stale_diag(const struct file *file, const char *phase)
+{
+    const struct file *real = READ_ONCE(file->private_data);
+    struct inode *inode = file_inode(file);
+    struct ovl_fs *ofs = OVL_FS(inode->i_sb);
+    if (strcmp(current->comm, "python3") || !real)
+        return;
+    pr_info("ovldiag %s file=%pD flags=%x mode=%x real=%pD rflags=%x rmode=%x rino=%lu nlink=%u mnt_current=%d gen=%lu/%lu\n",
+            phase, file, file->f_flags, file->f_mode, real, real->f_flags,
+            real->f_mode, file_inode(real)->i_ino, file_inode(real)->i_nlink,
+            real->f_path.mnt == ovl_upper_mnt(ofs),
+            (unsigned long)OVL_I(inode)->checkpoint_gen, (unsigned long)ofs->checkpoint_gen);
+}
 
