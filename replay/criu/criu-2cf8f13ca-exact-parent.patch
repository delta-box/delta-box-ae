+/* This mode requires immutable, ordinary local parent images. Reject damage
+ * and lazy-only parents rather than silently producing a purported delta.
+ */
+static int exact_validate_parent(struct page_read *p)
+{
+	unsigned long long bytes = 0, end = 0;
+	struct stat st;
+	int i;
+	for (i = 0; i < p->nr_pmes; i++) {
+		PagemapEntry *pe = p->pmes[i];
+		unsigned long long len = pe->nr_pages * PAGE_SIZE;
+		u32 flags = pe->flags;
+		if (!pe->nr_pages || pe->nr_pages > ULLONG_MAX / PAGE_SIZE ||
+		    pe->vaddr % PAGE_SIZE || pe->vaddr < end || pe->vaddr > ULLONG_MAX - len ||
+		    (flags & ~(PE_PRESENT | PE_PARENT | PE_LAZY)) ||
+		    !(flags & (PE_PRESENT | PE_PARENT)) ||
+		    ((flags & PE_PRESENT) && (flags & PE_PARENT))) {
+			pr_err("Invalid or unsupported exact parent pagemap\n");
+			return -1;
+		}
+		end = pe->vaddr + len;
+		if (flags & PE_PRESENT) {
+			if (bytes > ULLONG_MAX - len)
+				return -1;
+			bytes += len;
+		}
+	}
+	if (fstat(img_raw_fd(p->pi), &st) || st.st_size < 0 ||
+	    (unsigned long long)st.st_size != bytes) {
+		pr_err("Exact parent pages image length does not match pagemap\n");
+		return -1;
+	}
+	return p->parent ? exact_validate_parent(p->parent) : 0;
+}
