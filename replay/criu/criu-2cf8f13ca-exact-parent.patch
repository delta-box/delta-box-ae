+/* Write already-proven ranges directly: the comparison reader has advanced
+ * past this range, so write_pagemap_loc's forward-only existence check must
+ * not rewind it. Every PE_PARENT below was read successfully and memcmp-equal.
+ */
+static int exact_write_map(struct page_xfer *xfer, unsigned long addr, unsigned long len, u32 flags)
+{
+	PagemapEntry pe = PAGEMAP_ENTRY__INIT;
+	pe.vaddr = addr;
+	pe.has_nr_pages = true;
+	pe.nr_pages = len / PAGE_SIZE;
+	pe.has_flags = true;
+	pe.flags = flags;
+	return pb_write_one(xfer->pmi, &pe, PB_PAGEMAP);
+}
+
+static int exact_xfer_pages(struct page_xfer *xfer, int pipe, struct iovec *iov, u32 flags)
+{
+	unsigned long pos, run_start = 0, run_len = 0;
+	u32 run_flags = 0;
+	unsigned char *current, *parent;
+	int ret = -1;
+
+	if ((!(flags & PE_PRESENT) || (flags & ~(PE_PRESENT | PE_LAZY))) || xfer->offset || !xfer->parent || iov->iov_len % PAGE_SIZE) {
+		pr_err("Unsupported exact parent page transfer\n");
+		return -1;
+	}
+	current = xmalloc(PAGE_SIZE * 2);
+	if (!current)
+		return -1;
+	parent = current + PAGE_SIZE;
+	for (pos = 0; pos < iov->iov_len; pos += PAGE_SIZE) {
+		unsigned long addr = (unsigned long)iov->iov_base + pos;
+		size_t got = 0;
+		int found;
+		u32 output_flags = flags;
+		while (got < PAGE_SIZE) {
+			ssize_t n = read(pipe, current + got, PAGE_SIZE - got);
+			if (n < 0 && errno == EINTR)
+				continue;
+			if (n <= 0) {
+				pr_perror("Cannot read exact comparison page");
+				goto out;
+			}
+			got += n;
+		}
+		found = xfer->parent->seek_pagemap(xfer->parent, addr);
+		if (found < 0)
+			goto out;
+		if (found > 0) {
+			if (xfer->parent->read_pages(xfer->parent, addr, 1, parent, 0) != 1)
+				goto out;
+			xfer->exact_compared++;
+			if (!memcmp(current, parent, PAGE_SIZE))
+				output_flags = PE_PARENT | (flags & PE_LAZY);
+		}
+		if (run_len && output_flags != run_flags) {
+			if (exact_write_map(xfer, run_start, run_len, run_flags) < 0)
+				goto out;
+			run_len = 0;
+		}
+		if (!run_len) {
+			run_start = addr;
+			run_flags = output_flags;
+		}
+		run_len += PAGE_SIZE;
+		if (output_flags & PE_PRESENT) {
+			if (write_all(img_raw_fd(xfer->pi), current, PAGE_SIZE) != PAGE_SIZE)
+				goto out;
+			xfer->exact_written++;
+		} else {
+			xfer->exact_reused++;
+		}
+	}
+	if (run_len && exact_write_map(xfer, run_start, run_len, run_flags) < 0)
+		goto out;
+	ret = 0;
+out:
+	xfree(current);
+	return ret;
+}
