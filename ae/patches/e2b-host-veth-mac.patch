--- a/packages/orchestrator/pkg/sandbox/network/network.go
+++ b/packages/orchestrator/pkg/sandbox/network/network.go
@@ -52,6 +52,11 @@
 	// Create the Veth and Vpeer
 	vethAttrs := netlink.NewLinkAttrs()
 	vethAttrs.Name = s.VethName()
+	// Assign the host end before moving it out of the private namespace.
+	// Otherwise udev MACAddressPolicy=persistent can change its random MAC
+	// after networking has started, invalidating the peer's learned address.
+	// Slot IDs are unique on the host; 02:fd is locally administered unicast.
+	vethAttrs.HardwareAddr = net.HardwareAddr{0x02, 0xfd, byte(s.Idx >> 24), byte(s.Idx >> 16), byte(s.Idx >> 8), byte(s.Idx)}
 	veth := &netlink.Veth{
 		LinkAttrs: vethAttrs,
 		PeerName:  s.VpeerName(),
@@ -81,6 +86,9 @@
 	if err != nil {
 		return fmt.Errorf("error adding vpeer device address: %w", err)
 	}
+
+	logger.L().Debug(ctx, "host veth MAC assigned before namespace move",
+		zap.String("host_interface", s.VethName()), zap.String("host_mac", vethAttrs.HardwareAddr.String()))
 
 	// Move Veth device to the host NS
 	err = netlink.LinkSetNsFd(veth, int(hostNS))
