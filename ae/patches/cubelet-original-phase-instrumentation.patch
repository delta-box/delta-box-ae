+func logSnapshotPhaseTiming(
+	stepLog *log.CubeWrapperLogEntry,
+	flow string,
+	phase string,
+	sandboxID string,
+	templateID string,
+	start time.Time,
+	end time.Time,
+	extra CubeLog.Fields,
+) {
+	durationMs := float64(end.Sub(start).Microseconds()) / 1000.0
+	fields := CubeLog.Fields{
+		"snapshotTiming": "cube_ck_phase",
+		"flow":           flow,
+		"phase":          phase,
+		"sandboxID":      sandboxID,
+		"templateID":     templateID,
+		"startUnixNs":    start.UnixNano(),
+		"endUnixNs":      end.UnixNano(),
+		"durationMs":     durationMs,
+	}
+	for key, value := range extra {
+		fields[key] = value
+	}
+	stepLog.WithFields(fields).Warnf(
+		"cube_ck_phase_timing flow=%s phase=%s sandboxID=%s templateID=%s start_unix_ns=%d end_unix_ns=%d duration_ms=%.3f",
+		flow,
+		phase,
+		sandboxID,
+		templateID,
+		start.UnixNano(),
+		end.UnixNano(),
+		durationMs,
+	)
+}
