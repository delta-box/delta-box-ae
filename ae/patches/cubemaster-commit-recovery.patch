+
+func TestSnapshotRecoveryMySQL(t *testing.T) {
+ dsn := os.Getenv("CUBE_RECOVERY_MYSQL_DSN")
+ if dsn == "" { t.Skip("isolated MySQL DSN required") }
+ db,err:=gorm.Open(gm.Open(dsn),&gorm.Config{Logger:logger.Default.LogMode(logger.Silent)})
+ if err!=nil {t.Fatal(err)}
+ if err=db.AutoMigrate(&models.TemplateImageJob{});err!=nil{t.Fatal(err)}
+ old:=store.db;store.db=db;defer func(){store.db=old}()
+ lost:=errors.New("injected COMMIT response lost after durable commit")
+ newRow:=func(id string)*models.TemplateImageJob{
+  r:=&models.TemplateImageJob{JobID:id,RequestID:"req-"+id,ResourceID:"snap-"+id,SandboxID:"sandbox-test",Operation:JobOperationSnapshotCreate,Status:JobStatusPending,RequestJSON:"{\"test\":true}"}
+  return r
+ }
+ insert:=func(id string)*models.TemplateImageJob{r:=newRow(id);if e:=db.Create(r).Error;e!=nil{t.Fatal(e)};return r}
+ t.Run("create_commit_ack_lost",func(t *testing.T){
+  r:=newRow("create-ack");writes:=0
+  e:=persistSnapshotJob(context.Background(),r,func()error{writes++;if e:=db.Transaction(func(tx *gorm.DB)error{return tx.Create(r).Error});e!=nil{return e};return lost})
+  if e!=nil||writes!=1{t.Fatalf("err=%v writes=%d",e,writes)}
+ })
+ t.Run("create_rollback_does_not_invent_job",func(t *testing.T){
+  r:=newRow("create-rollback")
+  e:=persistSnapshotJob(context.Background(),r,func()error{return db.Transaction(func(tx *gorm.DB)error{if e:=tx.Create(r).Error;e!=nil{return e};return lost})})
+  if !errors.Is(e,lost){t.Fatalf("lost original error: %v",e)}
+  var n int64;db.Model(r).Where("job_id = ?",r.JobID).Count(&n);if n!=0{t.Fatal(n)}
+ })
+ t.Run("cancelled_caller_confirmation",func(t *testing.T){
+  r:=newRow("create-cancel");ctx,cancel:=context.WithCancel(context.Background());defer cancel()
+  e:=persistSnapshotJob(ctx,r,func()error{if e:=db.Create(r).Error;e!=nil{return e};cancel();return lost})
+  if e!=nil{t.Fatal(e)}
+ })
+ t.Run("payload_mismatch_rejected",func(t *testing.T){
+  r:=insert("mismatch");r.RequestJSON="different"
+  if e:=persistSnapshotJob(context.Background(),r,func()error{return lost});e==nil{t.Fatal("accepted mismatch")}
+ })
+ t.Run("claim_commit_ack_lost_one_owner",func(t *testing.T){
+  r:=insert("claim-ack")
+  if e:=db.Callback().Update().After("gorm:commit_or_rollback_transaction").Register("ae_lost_ack",func(tx *gorm.DB){if tx.Error==nil{tx.Error=lost}});e!=nil{t.Fatal(e)}
+  claimed,e:=claimSnapshotJobWithToken(context.Background(),r.JobID,JobPhaseSnapshotting,10,"owner-A")
+  db.Callback().Update().Remove("ae_lost_ack")
+  if e!=nil||!claimed{t.Fatalf("claimed=%v err=%v",claimed,e)}
+  claimed,e=claimSnapshotJobWithToken(context.Background(),r.JobID,JobPhaseSnapshotting,10,"owner-B")
+  if e!=nil||claimed{t.Fatalf("second owner claimed=%v err=%v",claimed,e)}
+  row,e:=readSnapshotJobForRecovery(context.Background(),r.JobID);if e!=nil||row.ExecutionToken!="owner-A"{t.Fatalf("%+v %v",row,e)}
+ })
+ t.Run("claim_rollback_never_executes",func(t *testing.T){
+  r:=insert("claim-rollback")
+  db.Callback().Update().Before("gorm:update").Register("ae_rollback",func(tx *gorm.DB){tx.Error=lost})
+  claimed,e:=claimSnapshotJobWithToken(context.Background(),r.JobID,JobPhaseSnapshotting,10,"owner-A")
+  db.Callback().Update().Remove("ae_rollback")
+  if claimed||!errors.Is(e,lost){t.Fatalf("claimed=%v err=%v",claimed,e)}
+  row,e:=readSnapshotJobForRecovery(context.Background(),r.JobID);if e!=nil||row.Status!=JobStatusPending{t.Fatalf("%+v %v",row,e)}
+ })
+ t.Run("concurrent_claims_one_owner",func(t *testing.T){
+  r:=insert("claim-concurrent");var n atomic.Int32;var wg sync.WaitGroup;errs:=make(chan error,8)
+  for i:=0;i<8;i++{wg.Add(1);go func(i int){defer wg.Done();yes,e:=claimSnapshotJobWithToken(context.Background(),r.JobID,JobPhaseSnapshotting,10,fmt.Sprintf("owner-%d",i));if e!=nil{errs<-e};if yes{n.Add(1)}}(i)}
+  wg.Wait();close(errs);for e:=range errs{t.Error(e)};if n.Load()!=1{t.Fatalf("owners=%d",n.Load())}
+ })
+ t.Run("locking_read_waits_for_inflight_commit",func(t *testing.T){
+  r:=insert("claim-wait");tx:=db.Begin()
+  if e:=tx.Table(constants.TemplateImageJobTableName).Where("job_id = ?",r.JobID).Updates(map[string]any{"status":JobStatusRunning,"execution_token":"owner-wait"}).Error;e!=nil{t.Fatal(e)}
+  done:=make(chan *models.TemplateImageJob,1);errc:=make(chan error,1)
+  go func(){row,e:=readSnapshotJobForRecovery(context.Background(),r.JobID);if e!=nil{errc<-e}else{done<-row}}()
+  select{case <-done:t.Fatal("read uncommitted outcome");case e:=<-errc:t.Fatal(e);case <-time.After(150*time.Millisecond):}
+  if e:=tx.Commit().Error;e!=nil{t.Fatal(e)}
+  select{case row:=<-done:if row.ExecutionToken!="owner-wait"{t.Fatal(row.ExecutionToken)};case e:=<-errc:t.Fatal(e);case <-time.After(10*time.Second):t.Fatal("confirmation stuck")}
+ })
+}
