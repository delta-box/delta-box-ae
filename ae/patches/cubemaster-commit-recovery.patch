+		r := insert("terminal-rollback")
+		db.Callback().Update().Before("gorm:update").Register("ae_terminal_rollback", func(tx *gorm.DB) { tx.Error = lost })
+		defer db.Callback().Update().Remove("ae_terminal_rollback")
+		e := updateSnapshotJobWithConfirmation(context.Background(), r.JobID, map[string]any{"status": JobStatusReady, "progress": 100})
+		if !errors.Is(e, lost) {
