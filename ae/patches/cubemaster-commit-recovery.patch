+func TestSnapshotDatabaseReadTimeout(t *testing.T) {
+	dsn := os.Getenv("CUBE_RECOVERY_MYSQL_DSN")
+	if dsn == "" {
+		t.Skip("isolated MySQL DSN required")
+	}
+	cfg, e := mysql.ParseDSN(dsn)
+	if e != nil {
+		t.Fatal(e)
+	}
+	for _, secs := range []int{5, 60} {
+		t.Run(fmt.Sprintf("read_timeout_%ds", secs), func(t *testing.T) {
+			c := *cfg
+			c.ReadTimeout = time.Duration(secs) * time.Second
+			conn, e := sql.Open("mysql", c.FormatDSN())
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer conn.Close()
+			ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+			defer cancel()
+			var result int
+			started := time.Now()
+			e = conn.QueryRowContext(ctx, "SELECT SLEEP(6)").Scan(&result)
+			t.Logf("readTimeout=%ds elapsed=%s error=%v", secs, time.Since(started), e)
+			if secs == 5 && e == nil {
+				t.Fatal("expected configured 5s socket timeout")
+			}
+			if secs == 60 && (e != nil || result != 0) {
+				t.Fatalf("6s response rejected: %v result=%d", e, result)
+			}
+		})
+	}
