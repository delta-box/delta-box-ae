+		var reads atomic.Int32
+		db.Callback().Query().Before("gorm:query").Register("ae_response_ready", func(tx *gorm.DB) {
+			if reads.Add(1) == 1 {
+				tx.Error = lost
+			}
+		})
+		defer db.Callback().Query().Remove("ae_response_ready")
+		info, e := finalizeSnapshotJobByID(context.Background(), r.JobID)
+		if e != nil || info == nil || info.Status != JobStatusReady {
+			t.Fatalf("%+v %v", info, e)
+		}
+	})
+	t.Run("response_read_does_not_promote_pending", func(t *testing.T) {
+		r := insert("response-pending")
+		var reads atomic.Int32
+		db.Callback().Query().Before("gorm:query").Register("ae_response_pending", func(tx *gorm.DB) {
+			if reads.Add(1) == 1 {
+				tx.Error = lost
+			}
+		})
+		defer db.Callback().Query().Remove("ae_response_pending")
+		if info, e := finalizeSnapshotJobByID(context.Background(), r.JobID); e == nil || info != nil {
+			t.Fatalf("promoted pending: %+v %v", info, e)
+		}
+	})
+	t.Run("response_read_does_not_hide_failure", func(t *testing.T) {
+		r := insert("response-failed")
+		db.Model(r).Updates(map[string]any{"status": JobStatusFailed, "error_message": "physical backend failure"})
+		var reads atomic.Int32
+		db.Callback().Query().Before("gorm:query").Register("ae_response_failed", func(tx *gorm.DB) {
+			if reads.Add(1) == 1 {
+				tx.Error = lost
+			}
+		})
+		defer db.Callback().Query().Remove("ae_response_failed")
+		if info, e := finalizeSnapshotJobByID(context.Background(), r.JobID); e == nil || e.Error() != "physical backend failure" || info != nil {
+			t.Fatalf("%+v %v", info, e)
+		}
+	})
+	t.Run("transient_rollback_reuses_exact_job", func(t *testing.T) {
+		r := newRow("transient-rollback")
+		writes := 0
+		e := persistSnapshotJob(context.Background(), r, func() error {
+			writes++
+			return db.Transaction(func(tx *gorm.DB) error {
+				if e := tx.Create(r).Error; e != nil {
+					return e
+				}
+				if writes == 1 {
+					return mysql.ErrInvalidConn
+				}
+				return nil
+			})
+		})
+		if e != nil || writes != 2 {
+			t.Fatalf("err=%v writes=%d", e, writes)
+		}
+		row, e := readSnapshotJobForRecovery(context.Background(), r.JobID)
+		if e != nil || row.RequestID != r.RequestID || row.RequestJSON != r.RequestJSON {
+			t.Fatalf("%+v %v", row, e)
+		}
+		var n int64
+		db.Model(r).Where("request_id = ?", r.RequestID).Count(&n)
+		if n != 1 {
+			t.Fatalf("logical jobs=%d", n)
+		}
+	})
+	t.Run("transient_rollback_bounded", func(t *testing.T) {
+		r := newRow("transient-bounded")
+		writes := 0
+		e := persistSnapshotJob(context.Background(), r, func() error { writes++; return mysql.ErrInvalidConn })
+		if !errors.Is(e, mysql.ErrInvalidConn) || writes != 3 {
+			t.Fatalf("%v writes=%d", e, writes)
+		}
+	})
+	t.Run("cancelled_rollback_does_not_retry", func(t *testing.T) {
+		r := newRow("transient-cancelled")
+		writes := 0
+		ctx, cancel := context.WithCancel(context.Background())
+		defer cancel()
+		e := persistSnapshotJob(ctx, r, func() error { writes++; cancel(); return mysql.ErrInvalidConn })
+		if e == nil || writes != 1 {
+			t.Fatalf("%v writes=%d", e, writes)
+		}
+	})
+	t.Run("inflight_insert_commit_is_not_repeated", func(t *testing.T) {
+		r := newRow("inflight-insert")
+		writes := 0
+		done := make(chan error, 1)
+		e := persistSnapshotJob(context.Background(), r, func() error {
+			writes++
+			tx := db.Begin()
+			if e := tx.Create(r).Error; e != nil {
+				tx.Rollback()
+				return e
+			}
+			go func() { time.Sleep(200 * time.Millisecond); done <- tx.Commit().Error }()
+			return mysql.ErrInvalidConn
+		})
+		if ce := <-done; ce != nil {
+			t.Fatal(ce)
+		}
+		if e != nil || writes != 1 {
+			t.Fatalf("%v writes=%d", e, writes)
+		}
+	})
+	t.Run("inflight_insert_rollback_then_retry", func(t *testing.T) {
+		r := newRow("inflight-rollback")
+		writes := 0
+		done := make(chan error, 1)
+		e := persistSnapshotJob(context.Background(), r, func() error {
+			writes++
+			if writes == 2 {
+				return db.Create(r).Error
+			}
+			tx := db.Begin()
+			if e := tx.Create(r).Error; e != nil {
+				tx.Rollback()
+				return e
+			}
+			go func() { time.Sleep(200 * time.Millisecond); done <- tx.Rollback().Error }()
+			return mysql.ErrInvalidConn
+		})
+		if re := <-done; re != nil {
+			t.Fatal(re)
+		}
+		if e != nil || writes != 2 {
+			t.Fatalf("%v writes=%d", e, writes)
+		}
+	})
+
