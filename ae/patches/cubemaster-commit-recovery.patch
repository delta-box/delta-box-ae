+package templatecenter
+
+import (
+	"context"
+	"database/sql/driver"
+	"errors"
+	"fmt"
+	mysql "github.com/go-sql-driver/mysql"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/log"
+	sandboxtypes "github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/service/sandbox/types"
+	"net"
+	"reflect"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/constants"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/db/models"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+// Recovery reads never reuse the cancelled request/failed transaction. A locking
+// current read waits for the original transaction to commit or roll back; an
+// ordinary consistent read could incorrectly report its uncommitted row absent.
+func readSnapshotJobForRecovery(ctx context.Context, jobID string) (*models.TemplateImageJob, error) {
+	recovery, cancel := context.WithTimeout(context.WithoutCancel(ctx), 90*time.Second)
+	defer cancel()
+	var last error
+	for {
+		var row models.TemplateImageJob
+		err := store.db.WithContext(recovery).Transaction(func(tx *gorm.DB) error {
+			return tx.Table(constants.TemplateImageJobTableName).
+				Clauses(clause.Locking{Strength: "UPDATE"}).Where("job_id = ?", jobID).Take(&row).Error
+		})
+		if err == nil {
+			return &row, nil
+		}
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, err
+		}
+		last = err
+		select {
+		case <-recovery.Done():
+			return nil, errors.Join(last, recovery.Err())
+		case <-time.After(100 * time.Millisecond):
+		}
+	}
+}
+
+// Retry only transient database failures, never validation/constraint errors.
+func transientSnapshotDBError(err error) bool {
+	var ne net.Error
+	var me *mysql.MySQLError
+	return errors.Is(err, mysql.ErrInvalidConn) || errors.Is(err, driver.ErrBadConn) ||
+		(errors.As(err, &ne) && ne.Timeout()) ||
+		(errors.As(err, &me) && (me.Number == 1205 || me.Number == 1213))
+}
+
+// The closure contains only the definition/job database transaction, no node
+// RPC. Reuse the exact logical IDs only after a locking read proves absence;
+// once COMMIT is visible, return without another write.
+func persistSnapshotJob(ctx context.Context, expected *models.TemplateImageJob, write func() error) error {
+	originalModel := expected.Model
+	for attempt := 0; attempt < 3; attempt++ {
+		cause := write()
+		if cause == nil {
+			return nil
+		}
+		row, err := readSnapshotJobForRecovery(ctx, expected.JobID)
+		if errors.Is(err, gorm.ErrRecordNotFound) && transientSnapshotDBError(cause) &&
+			ctx.Err() == nil && attempt < 2 {
+			// GORM may assign a numeric ID before the transaction rolls back.
+			expected.Model = originalModel
+			log.G(ctx).Warnf("retry snapshot job %s persistence after confirmed rollback: %v", expected.JobID, cause)
+			select {
+			case <-ctx.Done():
+				return errors.Join(cause, ctx.Err())
+			case <-time.After(time.Duration(attempt+1) * 100 * time.Millisecond):
+			}
+			continue
+		}
+		if err != nil {
+			return errors.Join(cause, fmt.Errorf("confirm snapshot job persistence: %w", err))
+		}
+		if row.RequestID != expected.RequestID || row.Operation != expected.Operation ||
+			row.ResourceID != expected.ResourceID || row.SandboxID != expected.SandboxID ||
+			row.RequestJSON != expected.RequestJSON {
+			return errors.Join(cause, errors.New("snapshot persistence confirmation payload mismatch"))
+		}
+		return nil
+	}
+	panic("unreachable")
+}
+
+func claimSnapshotJobWithToken(ctx context.Context, jobID, phase string, progress int32, token string) (bool, error) {
+	tx := store.db.WithContext(ctx).Table(constants.TemplateImageJobTableName).
+		Where("job_id = ? AND status = ?", jobID, JobStatusPending).
+		Updates(map[string]any{
+			"status": JobStatusRunning, "phase": phase, "progress": progress,
+			"execution_token": token, "updated_at": gorm.Expr("CURRENT_TIMESTAMP"),
+		})
+	if tx.Error == nil {
+		return tx.RowsAffected > 0, nil
+	}
+	row, err := readSnapshotJobForRecovery(ctx, jobID)
+	if err != nil {
+		return false, errors.Join(tx.Error, fmt.Errorf("confirm snapshot claim: %w", err))
+	}
+	if row.Status == JobStatusRunning && row.ExecutionToken == token {
+		return true, nil
+	}
+	if row.Status == JobStatusPending {
+		return false, tx.Error
+	}
+	// Another owner or a terminal result is not permission to issue a node RPC.
+	return false, nil
+}
+
+func newSnapshotExecutionToken() string { return uuid.NewString() }
+
+// updateSnapshotJobWithConfirmation is used only after the physical operation
+// succeeded. A lost update acknowledgement is not a reason to issue it again.
+// Verify every intended value, including the backend result payload, under a
+// locking current read; an uncommitted or different terminal result stays an error.
+func updateSnapshotJobWithConfirmation(ctx context.Context, jobID string, values map[string]any) error {
+	cause := updateTemplateImageJob(ctx, jobID, values)
+	if cause == nil {
+		return nil
+	}
+	row, err := readSnapshotJobForRecovery(ctx, jobID)
+	if err != nil {
+		return errors.Join(cause, fmt.Errorf("confirm snapshot completion: %w", err))
+	}
+	stmt := &gorm.Statement{DB: store.db}
+	if err := stmt.Parse(row); err != nil {
+		return errors.Join(cause, err)
+	}
+	for key, want := range values {
+		// MySQL timestamp precision can differ; it is not evidence of completion.
+		if key == "updated_at" {
+			continue
+		}
+		field := stmt.Schema.LookUpField(key)
+		if field == nil {
+			return errors.Join(cause, fmt.Errorf("unknown snapshot completion field %s", key))
+		}
+		got, _ := field.ValueOf(ctx, reflect.ValueOf(row))
+		if fmt.Sprint(got) != fmt.Sprint(want) {
+			return errors.Join(cause, fmt.Errorf("snapshot completion field %s does not match committed value", key))
+		}
+	}
+	log.G(ctx).Warnf("confirmed snapshot job %s completion after database acknowledgement error: %v", jobID, cause)
+	return nil
+}
+
+// This is a read-only recovery path. It cannot re-dispatch a snapshot operation
+// or turn a PENDING/RUNNING job into success; the existing finalizer enforces that.
+func getSnapshotJobInfoWithRecovery(ctx context.Context, jobID string) (*sandboxtypes.TemplateImageJobInfo, error) {
+	info, cause := GetTemplateImageJobInfo(ctx, jobID)
+	if cause == nil || errors.Is(cause, gorm.ErrRecordNotFound) || errors.Is(cause, ErrTemplateStoreNotInitialized) {
+		return info, cause
+	}
+	row, err := readSnapshotJobForRecovery(ctx, jobID)
+	if err != nil {
+		return nil, errors.Join(cause, fmt.Errorf("recover snapshot job response: %w", err))
+	}
+	return jobModelToInfo(context.WithoutCancel(ctx), row)
+}
