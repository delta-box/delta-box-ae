+-- Snapshot claim ownership survives loss of a COMMIT acknowledgement.
+-- +goose NO TRANSACTION
+-- +goose Up
+CALL cubemaster_acquire_migration_lock('cubemaster_migration_0004_snapshot_execution_token', 60);
+CALL cubemaster_add_column_if_missing('t_cube_template_image_job', 'execution_token', "varchar(36) NOT NULL DEFAULT ''");
+SELECT RELEASE_LOCK('cubemaster_migration_0004_snapshot_execution_token');
+-- +goose Down
+-- Owner tokens are retained on rollback for forensic safety; old binaries ignore them.
+SELECT 1;
