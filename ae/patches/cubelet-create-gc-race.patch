+// recordContainerStarted records only the successful Start observation. It must
+// not erase a real exit, pause, deletion or unknown observation from another
+// lifecycle operation; the creation/DeadGC lock prevents pre-start pollution.
+func recordContainerStarted(ci *cubeboxstore.Container, pid uint32) {
+	ci.Status.Update(func(status cubeboxstore.Status) (cubeboxstore.Status, error) {
